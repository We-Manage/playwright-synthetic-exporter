{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "docker:pinDigests", "helpers:pinGitHubActionDigestsToSemver"],
  "packageRules": [
    {
      "description": "The image ships the browsers for exactly one @playwright/test version.",
      "groupName": "playwright",
      "matchPackageNames": ["@playwright/test", "mcr.microsoft.com/playwright"]
    }
  ],
  "customManagers": [
    {
      "description": "hurl version of the CI job; its checksum next to it is set by hand.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": ["# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+: \"(?<currentValue>[^\"]+)\""]
    }
  ]
}
