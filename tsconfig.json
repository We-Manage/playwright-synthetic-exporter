{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "playwright-synthetic-exporter": ["./src/fixtures.ts"]
    }
  },
  "include": ["src/**/*.ts", "examples/**/*.ts", "test/**/*.ts"]
}
